import requests

API_KEY = "d06d6a6d325e6e2055d25c42ad00ef8e"
lat = "3.139"
lon = "101.6841"
start = "1735689600" # 1 January 2025 00:00:00
end = "1738368000" # 1 February 2025 00:00:00 (later for historical data use yearly data)
api_url = f"http://api.openweathermap.org/data/2.5/air_pollution/history?lat={lat}&lon={lon}&start={start}&end={end}&appid={API_KEY}"

def fetch_data():
    print("Get Pollution data from API")

    try:
        responses = requests.get(api_url)
        print(responses.json())
        print("Data is successfully taken")
        return responses.json
    except requests.exceptions.RequestException as e:
        print(f"An error occured: {e}")
        raise


fetch_data()